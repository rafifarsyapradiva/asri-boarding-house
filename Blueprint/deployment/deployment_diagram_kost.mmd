    %% =========================================================================
    %% PROTOCOL CONNECTIONS & COMMUNICATION PATHS
    %% =========================================================================
    BrowserApp <-->|"HTTPS (Port 443 - TLS 1.3)<br/>asriboardinghouse.weatso.id"| LiteSpeedEngine
