        UC22(["UC-22: Login Akun Manual"]):::baseUC
        UC24(["UC-24: Lupa & Reset Password"]):::extendUC
        UC17(["UC-17: Diskusi via Guest Chat"]):::baseUC
    end

    %% FLOW PHASE 2: RESERVATION & PRE-PAYMENT
    subgraph Phase2 ["Fase 2: Reservasi & Transisi Penyewa"]
